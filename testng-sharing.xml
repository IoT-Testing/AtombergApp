<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Atomberg – DEVICE SHARING & PERMISSION suite  (TWO PHONES)
  ═══════════════════════════════════════════════════════════════════════════
  Covers the Device Sharing & Permission Management feature (requirements v1.0):
    • DeviceSharingFlowTest       – Flows 1/2/3 cross-phone share via invite code
    • FanUiControlPermissionTest  – full UI-control permission matrix (spec §3.1)
    • SharingEdgeCaseTest         – edge cases & constraints (spec §6)
  PermissionModelTest (offline bitmask unit tests) is a separate <test> block
  and needs NO devices.

  ── Physical setup ─────────────────────────────────────────────────────────
    1. Connect BOTH phones by USB, enable USB debugging on each.
    2. `adb devices`  → note the two UDIDs.
    3. Both phones must be PRE-LOGGED-IN (admin on phone 1, member on phone 2).
       noReset=true preserves those sessions.

  ── Required environment variables ─────────────────────────────────────────
    ADMIN_DEVICE_UDID        UDID of admin phone
    MEMBER_DEVICE_UDID       UDID of member phone
    APPIUM_URL               default http://127.0.0.1:4723
    ADMIN_EMAIL / ADMIN_PASSWORD     (fallback login if a login screen appears)
    MEMBER_EMAIL / MEMBER_PASSWORD
    TEST_FAN_DEVICE_NAME     display name of the fan under test
    TEST_MEMBER_DISPLAY_NAME member's name as shown in the admin's family list
    ADMIN_DISPLAY_NAME       (optional) admin's name — enables §6.1 admin-row test

  ── Run ─────────────────────────────────────────────────────────────────────
      mvn test -DsuiteFile=testng-sharing.xml

  NOTE: These tests manage their own two drivers via DualDeviceManager, so this
  suite is NOT parallel and does NOT use the Device Farm auto-allocation path.
  Listeners are registered once via @Listeners on BaseDeviceSharingTest.
  ═══════════════════════════════════════════════════════════════════════════
-->
<suite name="Atomberg – Device Sharing Suite" verbose="2">

    <!-- Offline: bitmask permission-model unit tests (no phones needed) -->
    <test name="Permission Model (offline)">
        <classes>
            <class name="com.appTest.tests.PermissionModelTest"/>
        </classes>
    </test>

    <!-- Two-phone: end-to-end sharing flows, UI-control matrix, edge cases -->
    <test name="Device Sharing (two phones)">
        <classes>
            <class name="com.appTest.tests.DeviceSharingFlowTest"/>
            <class name="com.appTest.tests.DeviceShareLongPressFlowTest"/>
            <class name="com.appTest.tests.FanUiControlPermissionTest"/>
            <class name="com.appTest.tests.SharingEdgeCaseTest"/>
        </classes>
    </test>

</suite>
