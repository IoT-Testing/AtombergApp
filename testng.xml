<!-- testng.xml -->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AtombergAppFullTestSuite" parallel="tests" thread-count="4">

    <listeners>
        <listener class-name="com.appTest.listeners.DashboardReporter"/>
        <listener class-name="com.appTest.listeners.TestListeners"/>
    </listeners>

    <!-- ========================================================
         DEVICE CONFIGURATION NOTE:
         - deviceSlot  : Logical name for the device (used in reports)
         - deviceIp    : STF device IP address (from STF dashboard)
         - devicePort  : STF ADB port (default: 5555, check STF dashboard)
         Update deviceIp and devicePort for each device before running.
    ========================================================= -->

    <!-- ========== CORE TESTS ========== -->
    <test name="CoreAppTests">
        <parameter name="platform"    value="Android"/>
        <parameter name="deviceSlot"  value="device1"/>
        <parameter name="deviceIp"    value="192.168.1.101"/>
        <parameter name="devicePort"  value="5555"/>
        <classes>
            <class name="com.appTest.tests.OpenAppTest"/>
        </classes>
    </test>

    <!-- ========== AUTHENTICATION TESTS ========== -->
    <test name="AuthenticationTests">
        <parameter name="platform"    value="Android"/>
        <parameter name="deviceSlot"  value="device2"/>
        <parameter name="deviceIp"    value="192.168.1.102"/>
        <parameter name="devicePort"  value="5555"/>
        <classes>
            <class name="com.appTest.tests.LoginTest"/>
        </classes>
    </test>

    <!-- ========== MAIN APP FUNCTIONALITY TESTS ========== -->
    <test name="AppFunctionalityTests">
        <parameter name="platform"    value="Android"/>
        <parameter name="deviceSlot"  value="device1"/>
        <parameter name="deviceIp"    value="192.168.1.101"/>
        <parameter name="devicePort"  value="5555"/>
        <classes>
            <class name="com.appTest.tests.AppTest"/>
        </classes>
    </test>

    <!-- ========== DEVICE MANAGEMENT TESTS ========== -->
    <test name="DeviceManagementTests">
        <parameter name="platform"    value="Android"/>
        <parameter name="deviceSlot"  value="device2"/>
        <parameter name="deviceIp"    value="192.168.1.102"/>
        <parameter name="devicePort"  value="5555"/>
        <classes>
            <class name="com.appTest.tests.DeviceProvTest">
                <methods>
                    <include name="testDeviceProvisioning"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ========== USER PROFILE TESTS ========== -->
    <test name="ProfileManagementTests">
        <parameter name="platform"    value="Android"/>
        <parameter name="deviceSlot"  value="device1"/>
        <parameter name="deviceIp"    value="192.168.1.101"/>
        <parameter name="devicePort"  value="5555"/>
        <classes>
            <class name="com.appTest.tests.ManageProfileTest"/>
        </classes>
    </test>

    <!-- ========== FAMILY MANAGEMENT TESTS ========== -->
    <test name="FamilyManagementTests">
        <parameter name="platform"    value="Android"/>
        <parameter name="deviceSlot"  value="device2"/>
        <parameter name="deviceIp"    value="192.168.1.102"/>
        <parameter name="devicePort"  value="5555"/>
        <classes>
            <class name="com.appTest.tests.ManageFamilyTest"/>
        </classes>
    </test>

    <!-- ========== END-TO-END TESTS ========== -->
    <test name="EndToEndFlowTests">
        <parameter name="platform"    value="Android"/>
        <parameter name="deviceSlot"  value="device1"/>
        <parameter name="deviceIp"    value="192.168.1.101"/>
        <parameter name="devicePort"  value="5555"/>
        <classes>
            <class name="com.appTest.tests.SecondAppTest"/>
        </classes>
    </test>

    <!-- ========== SMOKE TESTS ========== -->
    <test name="SmokeTests" enabled="true">
        <parameter name="platform"    value="Android"/>
        <parameter name="deviceSlot"  value="device1"/>
        <parameter name="deviceIp"    value="192.168.1.101"/>
        <parameter name="devicePort"  value="5555"/>
        <classes>
            <class name="com.appTest.tests.OpenAppTest"/>
            <class name="com.appTest.tests.LoginTest">
                <methods>
                    <include name="correctCredentials_LoginSuccess"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>