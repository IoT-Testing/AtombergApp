# ─────────────────────────────────────────────────────────────────────────────
# Atomberg test environment — TEMPLATE
#
# Copy this file to `test.env`, fill in real values, and load it before running:
#   Bash/Git-Bash:   export $(grep -v '^#' test.env | xargs)
#   PowerShell:      Get-Content test.env | ? {$_ -and $_ -notmatch '^#'} | % { $kv=$_ -split '=',2; [Environment]::SetEnvironmentVariable($kv[0],$kv[1]) }
#
# NEVER commit test.env (it is git-ignored). This template holds no secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Default / primary test account (AppInitializer, Email fallback) ──
DEFAULT_EMAIL= "iot.testing.atomberg2@gmail.com"
DEFAULT_PASSWORD="Atomberg@123"

# ── Standalone Main.java runner ──
TEST_EMAIL="iot.testing.atomberg2@gmail.com"
TEST_PASSWORD="Atomberg@123"

# ── LoginTest account ──
LOGIN_TEST_EMAIL="iot.testing.atomberg2@gmail.com"
LOGIN_TEST_PASSWORD="Atomberg@123"
LOGIN_TEST_INVALID_PASSWORD="InvalidPassword123"

# ── Social / SSO login test accounts ──
APPLE_TEST_EMAIL=
APPLE_TEST_PASSWORD=
GOOGLE_TEST_EMAIL="iot.testing.atomberg@gmail.com"
ALEXA_TEST_EMAIL="iot.testing.atomberg2@gmail.com"
ALEXA_TEST_PASSWORD="Atomberg@123"

# ── SecondAppTest (quarantined — only needed if that suite is re-enabled) ──
SECOND_APP_EMAIL=
SECOND_APP_PASSWORD=

# ── Wi-Fi provisioning (device onboarding flows) ──
WIFI_SSID="Better_Together"
WIFI_PASSWORD="123@ToMb^rg#2425"

# ── Atomberg developer API — device-state oracle (fan / water purifier) ──
# Must belong to the SAME account logged into the app under test.
ATOMBERG_API_KEY=
ATOMBERG_REFRESH_TOKEN=
ATOMBERG_TEST_DEVICE_ID=

# ── Appium server (optional; defaults to http://127.0.0.1:4723) ──
# APPIUM_URL=http://127.0.0.1:4723
